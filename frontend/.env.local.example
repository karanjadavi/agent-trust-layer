# Copy this file to .env.local and fill in your TESTNET secret keys.
# .env.local is already gitignored — never commit real secret keys.
#
# Get these by running on your machine:
#   stellar keys show hackathon-deployer   (this is your "admin")
#   stellar keys show verifier-1
#   stellar keys show agent-1
#
# These must be TESTNET-ONLY keys with no real value. Never use a mainnet
# or personal wallet secret key here.

NEXT_PUBLIC_CONTRACT_ID=CDDWCPMK53VWWDGQ7O3HLXFOQOFTQOTRGJMPCUEBGBUBX2QA365OH2JU
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

NEXT_PUBLIC_ADMIN_SECRET=S...
NEXT_PUBLIC_VERIFIER_SECRET=S...
NEXT_PUBLIC_AGENT_SECRET=S...
